  "request_join_cases": [
    {
      "id": "responses-joined-once",
      "base_url": "https://api.example.com/v1",
      "api": "responses",
      "expected_request_url": "https://api.example.com/v1/responses"
    },
    {
      "id": "chat-completions-joined-once",
      "base_url": "https://api.example.com/v1",
      "api": "chat-completions",
      "expected_request_url": "https://api.example.com/v1/chat/completions"
    },
    {
      "id": "responses-root-base",
      "base_url": "https://api.example.com",
      "api": "responses",
      "expected_request_url": "https://api.example.com/responses"
    },
    {
      "id": "local-ipv6-chat-completions",
      "base_url": "http://[::1]:11434/v1",
      "api": "chat-completions",
      "expected_request_url": "http://[::1]:11434/v1/chat/completions"
    }
  ],
  "transport_guard_cases": [
    {
      "id": "wrong-credentials-no-fallback",
      "base_url": "https://api.example.com/v1",
      "model": "vendor/model-1",
      "api": "responses",
      "synthetic_http_status": 401,
      "expect": {
        "attempts": 1,
        "follow_redirect": false,
        "fallback_endpoint": false,
        "fallback_model": false,
        "credential_in_error": false
      }
    },
    {
      "id": "https-to-http-downgrade-redirect-not-followed",
      "base_url": "https://api.example.com/v1",
      "model": "vendor/model-1",
      "api": "responses",
      "synthetic_http_status": 302,
      "synthetic_location": "http://api.example.com/v1/responses",
      "expect": {
        "attempts": 1,
        "follow_redirect": false,
        "fallback_endpoint": false
      }
    },
    {
      "id": "loopback-http-to-lookalike-redirect-not-followed",
      "base_url": "http://127.0.0.1:8000/v1",
      "model": "local/model-1",
      "api": "chat-completions",
      "synthetic_http_status": 302,
      "synthetic_location": "http://127.0.0.1.example.com:8000/v1/chat/completions",
      "expect": {
        "attempts": 1,
        "follow_redirect": false,
        "fallback_endpoint": false
      }
    }
  ]
}
