class CommonsRelayOwnerUi
{
    SLOT(QString configure(QString profile))
    SLOT(QString refresh())
    SLOT(QString refreshPlanner())
    SLOT(QString startConversation(QString prompt, bool allowActions, QString maximumSpend))
    SLOT(QString cancelConversation())
    SLOT(QString loadConversation())
    SLOT(QString sendSignedCommand(QString json))
    SLOT(QString pollOwnerChannel())
    SLOT(QString loadOwnerProfiles())
    SLOT(QString selectOwnerProfile(QString name))
    SLOT(QString refreshAgent())
    SLOT(QString loadMoreTasks())
    SLOT(QString requestSkill(QString name))
    SLOT(QString requestTask(QString taskId))
    SLOT(QString submitTask(QString skill, QString argumentsJson, int expiresIn))
    SLOT(QString approveTask(QString taskId, QString intentHash, int policyVersion))
    SLOT(QString cancelTask(QString taskId))
    PROP(bool ready=false READONLY)
    PROP(bool connected=false READONLY)
    PROP(bool remoteReady=false READONLY)
    PROP(bool requestPending=false READONLY)
    PROP(bool signing=false READONLY)
    PROP(bool hasMoreTasks=false READONLY)
    PROP(QString statusText="Connecting the owner channel..." READONLY)
    PROP(QString agentId="" READONLY)
    PROP(QString selectedAgent="" READONLY)
    PROP(QString selectedProfile="" READONLY)
    PROP(QString profilesJson="[]" READONLY)
    PROP(QString plannerInfoJson="{}" READONLY)
    PROP(QString conversationJson="[]" READONLY)
    PROP(QString activeGoalId="" READONLY)
    PROP(bool chatBusy=false READONLY)
    PROP(QString summaryJson="{}" READONLY)
    PROP(QString transportHealthJson="{}" READONLY)
    PROP(QString tasksJson="[]" READONLY)
    PROP(QString skillsJson="[]" READONLY)
    PROP(QString taskDetailsJson="{}" READONLY)
    PROP(QString skillDetailsJson="{}" READONLY)
    PROP(QString ownerMessagesJson="[]" READONLY)
    PROP(QString lastResultJson="{}" READONLY)
    PROP(QString lastError="" READONLY)
}
