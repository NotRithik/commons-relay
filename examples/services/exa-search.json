{
  "schema": 1,
  "id": "exa.search",
  "description": "Search the web with Exa and return source links and excerpts",
  "executable": "exa-search",
  "executable_sha256": "12593f2b34a6fc4072168341b810e0a4d9ace24cd9c402169d6d1288e4d2b0bb",
  "timeout_seconds": 30,
  "public": true,
  "credentials": [
    "EXA_API_KEY"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400,
        "description": "This search query is sent to the provider and Exa."
      },
      "num_results": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "required": [
      "query",
      "num_results"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 400
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "url": {
              "type": "string",
              "maxLength": 1500
            },
            "excerpt": {
              "type": "string",
              "maxLength": 800
            }
          },
          "required": [
            "title",
            "url",
            "excerpt"
          ],
          "additionalProperties": false
        },
        "maxItems": 5
      },
      "returned": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "provider": {
        "type": "string",
        "enum": [
          "Exa"
        ]
      },
      "retrieved_at": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "query",
      "results",
      "returned",
      "provider",
      "retrieved_at"
    ],
    "additionalProperties": false
  }
}
